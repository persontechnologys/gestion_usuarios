# Nombre del proyecto, usado por Laravel en correos y en el nombre expuesto a Vite.
APP_NAME="Gestion de usuarios frontend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL pública del frontend; se ejecuta en el puerto 8001 para no chocar con el backend.
APP_URL=http://localhost:8001

# Zona horaria de Ecuador (UTC-5) usada para mostrar las fechas recibidas de la API.
APP_TIMEZONE=America/Guayaquil

# Idioma de la aplicación: español.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos local SQLite; solo guarda sesiones, caché y trabajos en cola, nunca usuarios.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Guarda las sesiones (y con ellas el token de la API) en la tabla sessions del servidor.
SESSION_DRIVER=file
# Duración de la sesión en minutos; debe coincidir con SANCTUM_EXPIRATION del backend.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# URL base de la API REST del backend, consumida solo desde el servidor.
BACKEND_API_URL=http://localhost:8000/api

# Tiempo máximo de espera en segundos para cada llamada a la API.
BACKEND_API_TIMEOUT=10
