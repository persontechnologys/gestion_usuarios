# ===== Variables para docker-compose (copiar como .env) =====
# Nunca subir el .env real a GitHub

# Puertos publicados en la máquina
FRONTEND_PORT=8080
BACKEND_PORT=8000

# URLs públicas
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000

# true solo para depurar en local
APP_DEBUG=true

# Claves de Laravel (copiar el APP_KEY de cada proyecto)
BACKEND_APP_KEY=
FRONTEND_APP_KEY=

# Base de datos
DB_DATABASE=gestion_usuarios
DB_USERNAME=gestion_usuarios
DB_PASSWORD=
DB_ROOT_PASSWORD=
